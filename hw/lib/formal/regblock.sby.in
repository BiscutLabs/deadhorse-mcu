[options]
mode {mode}
depth 12
timeout 180

[engines]
{engine}

[script]
read_slang --top RegBlockFormal {sources}
prep -top RegBlockFormal -flatten
fminit -seq reset_n 0,'z -seq checking 0,'z
async2sync
chformal -lower
select -assert-count {property_count} t:${property_type}
dffunmap

[files]
{files}
